BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_EMAIL=info@gtsystems.gr
BREVO_SENDER_NAME=GTSystems
TURNSTILE_SITE_KEY=your-cloudflare-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-secret-key
# Optional: local Chrome/Chromium path when it is not in a standard location.
# AUDIT_BROWSER_PATH=/usr/bin/chromium
# Optional: Google PageSpeed Insights API key with available quota.
# PAGESPEED_API_KEY=

# AI visibility checker: use the Gemini API from the server; never expose this key to the browser.
# Free-tier grounding currently depends on model and account eligibility.
# GEMINI_API_KEY=
# AI_VISIBILITY_MODEL=gemini-2.5-flash
# AI_VISIBILITY_MAX_RUNS_PER_DAY=20
