BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_EMAIL=info@gtsystems.gr
BREVO_SENDER_NAME=GTSystems
TURNSTILE_SITE_KEY=your-cloudflare-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-secret-key
# Optional: local Chrome/Chromium path when it is not in a standard location.
# AUDIT_BROWSER_PATH=/usr/bin/chromium
# Optional: Google PageSpeed Insights API key with available quota.
# PAGESPEED_API_KEY=

# AI visibility checker: configure one or more providers on the server; never expose keys to the browser.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AI_VISIBILITY_OPENAI_MODEL=gpt-4.1-mini
# AI_VISIBILITY_CLAUDE_MODEL=claude-sonnet-4-5
# AI_VISIBILITY_GEMINI_MODEL=gemini-2.5-flash
# Trial default: at most two scans per server day.
# AI_VISIBILITY_MAX_RUNS_PER_DAY=2
